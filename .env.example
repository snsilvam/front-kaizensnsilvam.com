# URL base del backend (Cloud Run o local)
VITE_API_URL=http://localhost:8080

# Valor que se envia en el header X-API-Key en cada peticion.
# OJO: al ser una app de navegador, esta clave queda visible en el bundle.
VITE_API_KEY=

# Clave que pide la ruta /sebas antes de mostrar el contenido.
# OJO: al ser una app de navegador, esta clave queda visible en el bundle.
VITE_SEBAS_KEY=

# Solo desarrollo: sirve datos de src/services/mock.ts en lugar de llamar
# a GET /dashboard. Dejar vacio o quitar para consumir el backend real.
VITE_USE_MOCK=false
